@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @* Top bar. The right side will hold the light/dark toggle later. *@
        <div class="top-row px-4">
            <span class="app-subtitle">Parent &amp; Student Management</span>
            <ThemeToggle />
        </div>

        @* Each page is drawn here. *@
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>