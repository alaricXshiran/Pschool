@page "/students"
@inject StudentService StudentService
@inject ParentService ParentService
@implements IDisposable

<PageTitle>Students</PageTitle>

<div class="page-header">
    <div>
        <h1>Students</h1>
        <p class="page-subtitle">Students registered at the school, with their parent</p>
    </div>

    <button class="btn btn-accent" @onclick="OpenAdd" disabled="@(parents.Count == 0)"
            title="@(parents.Count == 0 ? "Add a parent first" : "Add a new student")">
        <i class="bi bi-plus-lg"></i> Add Student
    </button>
</div>

@if (successMessage != null)
{
    <div class="alert alert-success py-2">@successMessage</div>
}
<div class="ps-card">
    <div class="ps-card-header">
        <h2>Students List</h2>
        <div class="filters">
            <select class="form-select form-select-sm parent-filter" aria-label="Filter by parent"
                    @bind="selectedParentId" @bind:after="OnParentChanged">
                <option value="">All parents</option>
                @foreach (var parent in parents)
                {
                    <option value="@parent.Id">@parent.FullName</option>
                }
            </select>

            <div class="search-box">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" class="form-control form-control-sm" placeholder="Search student or parent name"
                       aria-label="Search students" @bind="searchText" @bind:event="oninput"
                       @bind:after="OnSearchChanged" />
            </div>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger m-3">@errorMessage</div>
    }
    else if (result == null)
    {
        <p class="state-message">Loading...</p>
    }
    else if (result.Items.Count == 0)
    {
        <p class="state-message">
            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <text>No students match "@searchText".</text>
            }
            else if (selectedParentId.HasValue)
            {
                <text>This parent has no students yet.</text>
            }
            else
            {
                <text>No students found.</text>
            }
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table ps-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Date of Birth</th>
                        <th class="text-center">Age</th>
                        <th>Parent</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in result.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@student.FirstName</td>
                            <td class="fw-semibold">@student.LastName</td>
                            <td>@student.DateOfBirth.ToString("d MMM yyyy")</td>
                            <td class="text-center">@AgeOf(student.DateOfBirth)</td>
                            <td>
                                <i class="bi bi-person text-muted" aria-hidden="true"></i>
                                @student.ParentName
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-icon" title="Edit" aria-label="Edit @student.FirstName @student.LastName"
                                        @onclick="() => OpenEdit(student)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            </td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Page="result.Page" PageSize="result.PageSize" TotalCount="result.TotalCount" TotalPages="result.TotalPages"
               PageChanged="GoToPage" />
    }
</div>
@* Add / edit window *@
<Modal IsOpen="isFormOpen" Title="@(editingId == null ? "Add student" : "Edit student")" OnClose="CloseForm">
    <StudentForm Model="formModel" Parents="parents" SubmitText="@(editingId == null ? "Add student" : "Save changes")"
                 IsSaving="isSaving" ErrorMessage="@formError" OnSave="SaveAsync" OnCancel="CloseForm" />
</Modal>

@code {
    // How many students to show per page.
    private const int PageSize = 10;

    // The page currently shown, starting at 1.
    private int currentPage = 1;

    // What the user typed in the search box.
    private string searchText = string.Empty;

    // Cancels a waiting search when the user keeps typing.
    private CancellationTokenSource? searchDelay;

    // Every parent, for the filter dropdown.
    private List<ParentLookup> parents = new();

    // The parent chosen in the dropdown; null means all parents.
    private int? selectedParentId;

    // Add / edit form
    private bool isFormOpen;
    private bool isSaving;
    private string? formError;
    private string? successMessage;
    private StudentRequest formModel = new();

    // Id of the student being edited; null when adding.
    private int? editingId;

    // The page of students from the API; null until it arrives.
    private PagedResult<StudentResponse>? result;

    // Shown instead of the table if loading fails.
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Fill the dropdown; the table still loads if this fails.
        try
        {
            parents = await ParentService.GetLookupAsync();
        }
        catch (Exception)
        {
            parents = new();
        }

        await LoadAsync();
    }

    // Fetches the current page using the search text.
    private async Task LoadAsync()
    {
        errorMessage = null;

        try
        {
            result = await StudentService.GetPageAsync(currentPage, PageSize, selectedParentId, searchText);
        }
        catch (Exception)
        {
            errorMessage = "Could not load students. Check that the API is running.";
        }
    }

    // Called by the Pager when Previous or Next is clicked.
    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadAsync();
    }

    // Runs when a parent is chosen in the dropdown; starts from page 1.
    private async Task OnParentChanged()
    {
        currentPage = 1;
        await LoadAsync();
    }

    // Opens an empty form; pre-selects the filtered parent if there is one.
    private void OpenAdd()
    {
        editingId = null;
        formModel = new StudentRequest { ParentId = selectedParentId ?? 0 };
        formError = null;
        successMessage = null;
        isFormOpen = true;
    }

    // Opens the form filled with this student's details.
    private void OpenEdit(StudentResponse student)
    {
        editingId = student.Id;
        formModel = new StudentRequest
        {
            FirstName = student.FirstName,
            LastName = student.LastName,
            DateOfBirth = student.DateOfBirth,
            ParentId = student.ParentId
        };
        formError = null;
        successMessage = null;
        isFormOpen = true;
    }

    private void CloseForm()
    {
        isFormOpen = false;
    }

    // Saves as new or as an edit, depending on how the form was opened.
    private async Task SaveAsync(StudentRequest request)
    {
        isSaving = true;
        formError = null;

        var outcome = editingId == null
            ? await StudentService.CreateAsync(request)
            : await StudentService.UpdateAsync(editingId.Value, request);

        isSaving = false;

        if (!outcome.Success)
        {
            formError = outcome.ErrorMessage;
            return;
        }

        isFormOpen = false;
        successMessage = editingId == null
            ? $"{request.FirstName} {request.LastName} was added."
            : $"{request.FirstName} {request.LastName} was updated.";
        await LoadAsync();
    }
    // Waits for a pause in typing, then searches from page 1.
    private async Task OnSearchChanged()
    {
        searchDelay?.Cancel();
        searchDelay = new CancellationTokenSource();
        var token = searchDelay.Token;

        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        currentPage = 1;
        await LoadAsync();
    }

    // Stops any waiting search when leaving the page.
    public void Dispose()
    {
        searchDelay?.Cancel();
        searchDelay?.Dispose();
    }

    // Age in whole years on today's date.
    private static int AgeOf(DateOnly dateOfBirth)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dateOfBirth.Year;

        // Not had this year's birthday yet: one year younger.
        if (dateOfBirth > today.AddYears(-age))
        {
            age--;
        }

        return age;
    }
}