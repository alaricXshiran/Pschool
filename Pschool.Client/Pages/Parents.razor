@page "/parents"
@inject ParentService ParentService
@inject StudentService StudentService
@implements IDisposable

<PageTitle>Parents</PageTitle>

<div class="page-header">
    <div>
        <h1>Parents</h1>
        <p class="page-subtitle">Parents and guardians registered at the school</p>
    </div>

    <button class="btn btn-accent" @onclick="OpenAdd">
        <i class="bi bi-plus-lg"></i> Add Parent
    </button>
</div>

@if (successMessage != null)
{
    <div class="alert alert-success py-2">@successMessage</div>
}

<div class="ps-card">
    <div class="ps-card-header">
        <h2>Parents / Guardians List</h2>
        <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" class="form-control form-control-sm" placeholder="Search name, username or email"
                   aria-label="Search parents" @bind="searchText" @bind:event="oninput" @bind:after="OnSearchChanged" />
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger m-3">@errorMessage</div>
    }
    else if (result == null)
    {
        <p class="state-message">Loading...</p>
    }
    else if (result.Items.Count == 0)
    {
        <p class="state-message">
            @(string.IsNullOrWhiteSpace(searchText)
                ? "No parents found."
                : $"No parents match \"{searchText}\".")
        </p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table ps-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Home Address</th>
                        <th>Phone 1</th>
                        <th>Work Phone</th>
                        <th>Home Phone</th>
                        <th class="text-center">Siblings</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var parent in result.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@parent.FirstName</td>
                            <td class="fw-semibold">@parent.LastName</td>
                            <td>@ShowOrDash(parent.Username)</td>
                            <td>@ShowOrDash(parent.Email)</td>
                            <td>@ShowOrDash(parent.HomeAddress)</td>
                            <td>@ShowOrDash(parent.Phone1)</td>
                            <td>@ShowOrDash(parent.WorkPhone)</td>
                            <td>@ShowOrDash(parent.HomePhone)</td>
                            <td class="text-center">
                                <span class="siblings-badge">@parent.SiblingsCount</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-icon" title="View" aria-label="View @parent.FirstName @parent.LastName"
                                        @onclick="() => OpenView(parent)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-icon" title="Edit" aria-label="Edit @parent.FirstName @parent.LastName"
                                        @onclick="() => OpenEdit(parent)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-icon btn-icon-danger" title="Delete"
                                        aria-label="Delete @parent.FirstName @parent.LastName" @onclick="() => OpenDelete(parent)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager Page="result.Page" PageSize="result.PageSize" TotalCount="result.TotalCount" TotalPages="result.TotalPages"
               PageChanged="GoToPage" />
    }
</div>


@* ---- Add / edit window ---- *@
<Modal IsOpen="isFormOpen" Title="@(editingId == null ? "Add parent" : "Edit parent")" OnClose="CloseForm">
    <ParentForm Model="formModel" SubmitText="@(editingId == null ? "Add parent" : "Save changes")" IsSaving="isSaving"
                ErrorMessage="@formError" OnSave="SaveAsync" OnCancel="CloseForm" />
</Modal>

@* ---- View details window (read-only) ---- *@
<Modal IsOpen="viewParent != null" Title="Parent details" OnClose="CloseView">
    @if (viewParent != null)
    {
        <dl class="details-grid">
            <dt>Name</dt>
            <dd>@viewParent.FirstName @viewParent.LastName</dd>

            <dt>Username</dt>
            <dd>@ShowOrDash(viewParent.Username)</dd>

            <dt>Email</dt>
            <dd>@ShowOrDash(viewParent.Email)</dd>

            <dt>Home address</dt>
            <dd>@ShowOrDash(viewParent.HomeAddress)</dd>

            <dt>Phone 1</dt>
            <dd>@ShowOrDash(viewParent.Phone1)</dd>

            <dt>Work phone</dt>
            <dd>@ShowOrDash(viewParent.WorkPhone)</dd>

            <dt>Home phone</dt>
            <dd>@ShowOrDash(viewParent.HomePhone)</dd>
        </dl>

        <h3 class="details-subheading">Children (@viewParent.SiblingsCount)</h3>

        @if (viewError != null)
        {
            <div class="alert alert-danger py-2">@viewError</div>
        }
        else if (viewChildren == null)
        {
            <p class="text-muted mb-0">Loading...</p>
        }
        else if (viewChildren.Count == 0)
        {
            <p class="text-muted mb-0">No students registered for this parent.</p>
        }
        else
        {
            <ul class="children-list">
                @foreach (var child in viewChildren)
                {
                    <li>
                        <i class="bi bi-person-fill" aria-hidden="true"></i>
                        <span class="fw-semibold">@child.FirstName @child.LastName</span>
                        <span class="text-muted ms-auto">Born @child.DateOfBirth.ToString("d MMM yyyy")</span>
                    </li>
                }
            </ul>
        }

        <div class="form-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseView">Close</button>
        </div>
    }
</Modal>

@* ---- Delete confirmation window ---- *@
<Modal IsOpen="deleteParent != null" Title="Delete parent" OnClose="CloseDelete">
    @if (deleteParent != null)
    {
        @if (!string.IsNullOrWhiteSpace(deleteError))
        {
            <div class="alert alert-danger py-2">@deleteError</div>
        }

        @if (deleteParent.SiblingsCount > 0)
        {
            @* Blocked: every student must keep a parent. *@
            <p>
                <strong>@deleteParent.FirstName @deleteParent.LastName</strong>
                has @deleteParent.SiblingsCount student(s) and cannot be deleted.
            </p>
            <p class="text-muted mb-0">Delete those students or move them to another parent first.</p>

            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseDelete">Close</button>
            </div>
        }
        else
        {
            <p>
                Delete <strong>@deleteParent.FirstName @deleteParent.LastName</strong>?
                This cannot be undone.
            </p>

            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseDelete" disabled="@isDeleting">
                    Cancel
                </button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                    @(isDeleting ? "Deleting..." : "Delete")
                </button>
            </div>
        }
    }
</Modal>

@code {
    // How many parents to show per page.
    private const int PageSize = 10;

    // The page currently shown, starting at 1.
    private int currentPage = 1;

    // What the user typed in the search box.
    private string searchText = string.Empty;

    // Used to cancel a waiting search when the user keeps typing.
    private CancellationTokenSource? searchDelay;

    // The page of parents from the API; null until it arrives.
    private PagedResult<ParentResponse>? result;

    // Shown instead of the table if loading fails.
    private string? errorMessage;

    // ---- Add / edit form ----
    private bool isFormOpen;
    private bool isSaving;
    private string? formError;
    private string? successMessage;
    private ParentRequest formModel = new();

    // Id of the parent being edited, or null when adding a new one.
    private int? editingId;


    // ---- View details ----
    // The parent being viewed; the window is open while this is not null.
    private ParentResponse? viewParent;

    // That parent's children; null while loading.
    private List<StudentResponse>? viewChildren;
    private string? viewError;


    // ---- Delete ----
    // The parent awaiting confirmation; the window is open while this is not null.
    private ParentResponse? deleteParent;
    private bool isDeleting;
    private string? deleteError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // Fetch the current page from the API, using the search text.
    private async Task LoadAsync()
    {
        errorMessage = null;

        try
        {
            result = await ParentService.GetPageAsync(currentPage, PageSize, searchText);
        }
        catch (Exception)
        {
            errorMessage = "Could not load parents. Check that the API is running.";
        }
    }

    // Called by the Pager when Previous or Next is clicked.
    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadAsync();
    }

    // Open the form with empty fields.
    private void OpenAdd()
    {
        editingId = null;
        formModel = new ParentRequest();
        formError = null;
        successMessage = null;
        isFormOpen = true;
    }

    // Open the form filled with this parent's current details.
    private void OpenEdit(ParentResponse parent)
    {
        editingId = parent.Id;
        formModel = new ParentRequest
        {
            FirstName = parent.FirstName,
            LastName = parent.LastName,
            Username = parent.Username,
            Email = parent.Email,
            HomeAddress = parent.HomeAddress,
            Phone1 = parent.Phone1,
            WorkPhone = parent.WorkPhone,
            HomePhone = parent.HomePhone
        };
        formError = null;
        successMessage = null;
        isFormOpen = true;
    }

    private void CloseForm()
    {
        isFormOpen = false;
    }

    // Called by the form after it passes validation.
    private async Task SaveAsync(ParentRequest request)
    {
        isSaving = true;
        formError = null;

        // Add or edit, depending on how the form was opened.
        var outcome = editingId == null
            ? await ParentService.CreateAsync(request)
            : await ParentService.UpdateAsync(editingId.Value, request);

        isSaving = false;

        if (!outcome.Success)
        {
            // Keep the form open and show what the API said.
            formError = outcome.ErrorMessage;
            return;
        }

        isFormOpen = false;
        successMessage = editingId == null
            ? $"{request.FirstName} {request.LastName} was added."
            : $"{request.FirstName} {request.LastName} was updated.";
        await LoadAsync();
    }

    // Open the details window, then load this parent's children.
    private async Task OpenView(ParentResponse parent)
    {
        viewParent = parent;
        viewChildren = null;
        viewError = null;

        try
        {
            // The API allows at most 100 per page, far more than one family has.
            var children = await StudentService.GetPageAsync(page: 1, pageSize: 100, parentId: parent.Id);
            viewChildren = children.Items;
        }
        catch (Exception)
        {
            viewError = "Could not load this parent's students.";
        }
    }

    private void CloseView()
    {
        viewParent = null;
    }

    // Open the confirmation window for this parent.
    private void OpenDelete(ParentResponse parent)
    {
        deleteParent = parent;
        deleteError = null;
        successMessage = null;
    }

    private void CloseDelete()
    {
        deleteParent = null;
    }

    // Called when the user confirms the delete.
    private async Task ConfirmDeleteAsync()
    {
        if (deleteParent == null)
        {
            return;
        }

        isDeleting = true;
        deleteError = null;

        var outcome = await ParentService.DeleteAsync(deleteParent.Id);

        isDeleting = false;

        if (!outcome.Success)
        {
            // e.g. a student was added meanwhile: show the API's reason.
            deleteError = outcome.ErrorMessage;
            return;
        }

        successMessage = $"{deleteParent.FirstName} {deleteParent.LastName} was deleted.";
        deleteParent = null;

        // If that was the only row on a later page, step back one page.
        if (result != null && result.Items.Count == 1 && currentPage > 1)
        {
            currentPage--;
        }

        await LoadAsync();
    }

    // Runs on every keystroke. Waits for a short pause, then searches once.
    private async Task OnSearchChanged()
    {
        // Cancel the previous wait: the user is still typing.
        searchDelay?.Cancel();
        searchDelay = new CancellationTokenSource();
        var token = searchDelay.Token;

        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        // A new search starts from the first page.
        currentPage = 1;
        await LoadAsync();
    }

    // Called when the user leaves the page: stop any waiting search.
    public void Dispose()
    {
        searchDelay?.Cancel();
        searchDelay?.Dispose();
    }

    // Optional fields: show the value, or a soft dash when empty.
    private static RenderFragment ShowOrDash(string? value) => builder =>
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            builder.AddMarkupContent(0, "<span class=\"text-muted\">&mdash;</span>");
        }
        else
        {
            builder.AddContent(0, value);
        }
    };
}
